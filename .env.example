# KnowFlow AI Docker Compose environment.
# Copy this file to .env, then replace every CHANGE_ME value before production use.

# Host port used by the frontend Nginx container.
KNOWFLOW_FRONTEND_PORT=5173

# Host port used by the backend Spring Boot container.
KNOWFLOW_BACKEND_PORT=8080

# PostgreSQL host port. Keep 5432 for local demos unless another local Postgres already uses it.
KNOWFLOW_POSTGRES_PORT=5432

# PostgreSQL database used by the backend service.
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# JWT signing secret. Use at least 32 random characters in real deployments.
KNOWFLOW_JWT_SECRET=CHANGE_ME_use_a_long_random_jwt_secret_at_least_32_chars

# User model API Key encryption secret. Changing it makes previously saved user API Keys undecryptable.
KNOWFLOW_MODEL_SECRET_KEY=CHANGE_ME_use_a_long_random_model_secret_at_least_32_chars

# Optional OpenAI-compatible fallback config used only when a user has not saved their own Settings model config.
KNOWFLOW_AI_BASE_URL=
KNOWFLOW_AI_API_KEY=
KNOWFLOW_AI_MODEL=
# Optional embedding model used by Stage 18 semantic retrieval. Leave empty to keep full-text retrieval only.
KNOWFLOW_AI_EMBEDDING_MODEL=
KNOWFLOW_AI_TIMEOUT_SECONDS=60

# Optional Aliyun OSS config used by Stage 21 avatar upload.
# Leave empty if avatar upload is not enabled; default avatar presets still work.
KNOWFLOW_OSS_ENDPOINT=
KNOWFLOW_OSS_BUCKET=
KNOWFLOW_OSS_ACCESS_KEY_ID=
KNOWFLOW_OSS_ACCESS_KEY_SECRET=
KNOWFLOW_OSS_AVATAR_PREFIX=knowflow/avatars
KNOWFLOW_OSS_SIGNED_URL_TTL_SECONDS=3600

# Backend database pool sizing. The defaults are conservative for local/demo Docker runs.
KNOWFLOW_DB_MAX_POOL_SIZE=10
KNOWFLOW_DB_MIN_IDLE=1
